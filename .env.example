# Vorlage: kopieren nach .env und Werte einsetzen
# Zufallswert: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Datenbank
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://shop:change-me@db:5432/shop